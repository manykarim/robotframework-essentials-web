{
  "name": "robotframework-essentials-web",
  "type": "module",
  "version": "0.0.1",
  "description": "Robot Framework Essentials, a hands-on Robot Framework course, as a website.",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/manykarim/robotframework-essentials-web.git"
  },
  "homepage": "https://manykarim.github.io/robotframework-essentials-web/",
  "scripts": {
    "dev": "node scripts/rfe-runtime.mjs && astro dev",
    "start": "node scripts/rfe-runtime.mjs && astro dev",
    "build": "node scripts/rfe-runtime.mjs && astro build",
    "preview": "astro preview",
    "runtime": "node scripts/rfe-runtime.mjs",
    "test:ci": "node scripts/rfe-runtime.mjs && astro check && astro build && npm run test:rfe",
    "test:rfe": "node --test \"src/rfe/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "smoke": "sh scripts/smoke.sh",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.5",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "astro": "^7.2.10",
    "dompurify": "^3.4.16",
    "pyodide": "314.0.7",
    "sharp": "^0.35.3",
    "starlight-links-validator": "^0.26.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
